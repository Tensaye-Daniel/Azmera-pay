# Backend environment sample - copy to .env and fill in
DEBUG=1
DJANGO_SECRET_KEY=change-me
# DB_URL=postgres://azmera:azmera@localhost:5432/azmera_pay
# DB_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
# Prefix the ngrok tunnel host so Africa's Talking callbacks reach Django, e.g.
# ALLOWED_HOSTS=localhost,127.0.0.1,your-tunnel.ngrok-free.dev
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Farmer document encryption key (Fernet, URL-safe base64). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty in local development to derive a key from DJANGO_SECRET_KEY.
FARMER_DOCUMENT_ENCRYPTION_KEY=
FARMER_DOCUMENT_MAX_BYTES=5242880

# USSD/SMS gateway adapter (farmer channel)
# Use "africastalking" in production and "mock" for local/tests.
USSD_GATEWAY=mock
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SHORTCODE=*384*54009#
# Optional: require callbacks to include ?token=... or the X-USSD-Secret header.
USSD_CALLBACK_SECRET=
USSD_MAX_MESSAGE_LENGTH=182
# USSD menu language: "en" (default) or "am".
USSD_DEFAULT_LANGUAGE=en
# NEGROCK_API_KEY=